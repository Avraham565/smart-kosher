# Python caches and build output
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.spec

# Local Python environments
.venv/
.venv-*/
venv/
env/

# Local editor/agent state
.vscode/
.idea/
.claude/settings.local.json

# Local runtime state
.tmp/
*.log
*.pid
settings.json
dev_data/
tests/.tmp-storage/
tests/.tmp-*/

# External/vendor checkouts. Anchored: this is for a clone dropped at the repo
# root, and unanchored it also swallowed
# products/panel/firmware/lvgl_micropython/ -- the patches that make the panel's
# firmware what it is. A directory exclusion cannot be undone by a later
# negation, because git never descends into it to see one, so the rule has to
# say where it means.
/lvgl_micropython/

# Hardware and firmware build artifacts
firmware/h2_coordinator/build/
firmware/h2_coordinator/sdkconfig
firmware/h2_coordinator/managed_components/
# dependencies.lock is deliberately NOT ignored: it records the exact
# esp-zigbee-lib build the firmware was verified against on hardware. It was
# ignored before, and since the build script builds in a throwaway C:\tmp copy,
# the lock never survived a build -- so every build re-resolved its dependencies
# from scratch.
h2_factory_backup.bin
*.elf
*.map
*.uf2

# Datasheet source PDFs are large; keep Markdown extracts in git.
data-sheets/*.pdf
