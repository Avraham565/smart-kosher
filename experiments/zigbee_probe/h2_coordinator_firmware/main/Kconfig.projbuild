menu "Smart Kosher H2 Coordinator"

    config COORD_UART_PORT
        int "UART port used for S3 slot communication"
        default 1

    config COORD_UART_TXD_PIN
        int "UART TX GPIO"
        default 24
        help
            Per-target value comes from sdkconfig.defaults.<target>.
            esp32h2 (CrowPanel slot): GPIO24 -> S3 GPIO19.
            esp32c6 (NanoC6 Grove):   GPIO1 (white) -> AtomS3 G1.

    config COORD_UART_RXD_PIN
        int "UART RX GPIO"
        default 2
        help
            Per-target value comes from sdkconfig.defaults.<target>.
            esp32h2 (CrowPanel slot): S3 GPIO5 -> GPIO2.
            esp32c6 (NanoC6 Grove):   AtomS3 G2 (yellow) -> GPIO2.

    config COORD_UART_BAUD_RATE
        int "UART baud rate"
        default 115200

    config COORD_BOOT_BEACON_COUNT
        int "Boot beacon repeat count"
        default 10

endmenu
