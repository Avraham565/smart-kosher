index 03c0732..ea8b4bb 100644
--- a/ext_mod/lcd_bus/esp32_src/rgb_bus.c
+++ b/ext_mod/lcd_bus/esp32_src/rgb_bus.c
@@ -385,7 +385,31 @@
         self->bytes_per_pixel = bpp / 8;
 
         self->panel_io_config.flags.fb_in_psram = 1;
+        // TWO framebuffers, and this is what kills tearing: strips go into
+        // the idle buffer and esp_lcd switches to it at a frame boundary, so
+        // the panel never scans a buffer that is being written.
+        //
+        // Set to 0 on 2026-08-27 on the theory that the second buffer was
+        // what left bands on a pressed card. FALSIFIED: with one framebuffer
+        // the bands were unchanged. The real cause was an off-by-one in
+        // rotate0 (rgb_bus_rotation.c) that never wrote the last row of any
+        // partial-width strip. With that fixed the bands are gone, and one
+        // framebuffer bought nothing but a visible top-to-bottom tear.
+        //
+        // What it did buy, measured: without a second buffer the whole-frame
+        // resync memcpy below never runs, and a press went from ~87ms to
+        // ~40ms. That memcpy is real waste -- 768,000 bytes to repair a
+        // region that is usually a fraction of the screen -- but the answer
+        // is to copy only the region that changed, not to drop the buffer.
         self->panel_io_config.flags.double_fb = 1;
+        // Mirror the stable C panel firmware: enable esp_lcd bounce
+        // buffers so the LCD scans from internal SRAM (refilled from
+        // PSRAM) instead of reading the framebuffer straight out of
+        // PSRAM. This is the real fix for scanout jitter; it pairs with
+        // the 64B data cache line + SPIRAM XIP now set in sdkconfig.
+        // 10 lines = 800*10*2 = 16KB x2 internal SRAM (matches C).
+        self->panel_io_config.bounce_buffer_size_px =
+            (size_t)(self->width * 10);
 
         rgb_bus_lock_init(&self->copy_lock);
         rgb_bus_lock_init(&self->tx_color_lock);
